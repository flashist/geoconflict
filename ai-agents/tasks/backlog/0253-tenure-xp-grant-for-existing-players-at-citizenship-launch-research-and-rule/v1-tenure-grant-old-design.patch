+++ b/tests/profile-server/TenureGrantRoutes.test.ts
@@ -0,0 +1,217 @@
+// Route tests for the tenure XP grant (task 0253) over a mocked TenureGrantRepo —
+// same harness as NameChangeRoutes.test.ts. supertest-based, so this suite is
+// part of the known supertest flake family (see CLAUDE.md, "Known flake").
+
+import request from "supertest";
+import { TENURE_WINDOW_OPENS_AT_MS } from "../../src/core/profile/TenureGrantContract";
+import type { TenureGrantOutcome } from "../../src/profile-server/PlayerProfileRepository";
+import {
+  createApp,
+  type ProfileRepo,
+  type TenureGrantRepo,
+} from "../../src/profile-server/Routes";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const PLAYER = "yandex-1";
+const NOW = TENURE_WINDOW_OPENS_AT_MS + 5 * DAY_MS;
+const PATH = "/v1/profile/tenure-grant";
+
+function mockRepo(): ProfileRepo {
+  return {
+    ping: jest.fn().mockResolvedValue(undefined),
+    getProfile: jest.fn().mockResolvedValue(null),
+    upsertProfile: jest.fn(),
+    creditMatchXp: jest.fn(),
+  };
+}
+
+function outcome(overrides: Partial<TenureGrantOutcome>): TenureGrantOutcome {
+  return {
+    status: "granted",
+    xpAwarded: 12,
+    xp: 20,
+    citizenshipNewlyGranted: false,
+    ...overrides,
+  };
+}
+
+function mockTenureGrant(result?: TenureGrantOutcome | Error): TenureGrantRepo {
+  const grantTenureXp = jest.fn();
+  if (result instanceof Error) {
+    grantTenureXp.mockRejectedValue(result);
+  } else {
+    grantTenureXp.mockResolvedValue(result ?? outcome({}));
+  }
+  return { grantTenureXp };
+}
+
+/** `null` = build the app WITHOUT a tenure-grant repo (fail-closed path). */
+function appWith(tenureGrant: TenureGrantRepo | null = mockTenureGrant()) {
+  return createApp(
+    mockRepo(),
+    undefined,
+    undefined,
+    undefined,
+    tenureGrant ?? undefined,
+  );
+}
+
+function evidence(overrides: Record<string, unknown> = {}) {
+  return {
+    daysPlayed: 12,
+    gameRecordDays: 4,
+    firstPlayedAt: NOW - 200 * DAY_MS,
+    snapshotTakenAt: NOW - DAY_MS,
+    ...overrides,
+  };
+}
+
+describe("POST /v1/profile/tenure-grant", () => {
+  beforeEach(() => {
+    jest.spyOn(Date, "now").mockReturnValue(NOW);
+  });
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  it("200 granted, with the server-computed amount passed to the repository", async () => {
+    const tenureGrant = mockTenureGrant(outcome({ xpAwarded: 12, xp: 20 }));
+    const body = { yandexPlayerId: PLAYER, evidence: evidence() };
+    await request(appWith(tenureGrant))
+      .post(PATH)
+      .send(body)
+      .expect(200, { status: "granted", xpAwarded: 12, xp: 20 });
+    expect(tenureGrant.grantTenureXp).toHaveBeenCalledWith(
+      PLAYER,
+      12,
+      body.evidence,
+    );
+  });
+
+  it("200 duplicate carries the stored amount", async () => {
+    const tenureGrant = mockTenureGrant(
+      outcome({ status: "duplicate", xpAwarded: 30, xp: 45 }),
+    );
+    await request(appWith(tenureGrant))
+      .post(PATH)
+      .send({ yandexPlayerId: PLAYER, evidence: evidence() })
+      .expect(200, { status: "duplicate", xpAwarded: 30, xp: 45 });
+  });
+
+  it("ignores a client-sent amount — the server computes it", async () => {
+    const tenureGrant = mockTenureGrant();
+    await request(appWith(tenureGrant))
+      .post(PATH)
+      .send({
+        yandexPlayerId: PLAYER,
+        xpAwarded: 999,
+        evidence: { ...evidence({ daysPlayed: 80 }), xpAwarded: 999 },
+      })
+      .expect(200);
+    const call = (tenureGrant.grantTenureXp as jest.Mock).mock.calls[0];
+    expect(call[1]).toBe(50);
+    expect(call[2]).not.toHaveProperty("xpAwarded");
+  });
+
+  it.each([
+    ["below_minimum", evidence({ daysPlayed: 2, gameRecordDays: 1 })],
+    ["implausible", evidence({ snapshotTakenAt: NOW + 2 * DAY_MS })],
+  ])(
+    "422 %s from the rules, without touching the repository",
+    async (reason, ev) => {
+      const tenureGrant = mockTenureGrant();
+      await request(appWith(tenureGrant))
+        .post(PATH)
+        .send({ yandexPlayerId: PLAYER, evidence: ev })
+        .expect(422, { error: reason });
+      expect(tenureGrant.grantTenureXp).not.toHaveBeenCalled();
+    },
+  );
+
+  it("422 window_not_open before the window", async () => {
+    (Date.now as jest.Mock).mockReturnValue(TENURE_WINDOW_OPENS_AT_MS - 1);
+    const tenureGrant = mockTenureGrant();
+    await request(appWith(tenureGrant))
+      .post(PATH)
+      .send({
+        yandexPlayerId: PLAYER,
+        evidence: evidence({
+          firstPlayedAt: TENURE_WINDOW_OPENS_AT_MS - 100 * DAY_MS,
+          snapshotTakenAt: TENURE_WINDOW_OPENS_AT_MS - DAY_MS,
+        }),
+      })
+      .expect(422, { error: "window_not_open" });
+    expect(tenureGrant.grantTenureXp).not.toHaveBeenCalled();
+  });
+
+  it("422 window_closed after the window", async () => {
+    (Date.now as jest.Mock).mockReturnValue(
+      TENURE_WINDOW_OPENS_AT_MS + 90 * DAY_MS,
+    );
+    await request(appWith())
+      .post(PATH)
+      .send({ yandexPlayerId: PLAYER, evidence: evidence() })
+      .expect(422, { error: "window_closed" });
+  });
+
+  it.each(["no_profile", "no_credited_match"] as const)(
+    "422 %s from the repository",
+    async (status) => {
+      await request(
+        appWith(mockTenureGrant(outcome({ status, xpAwarded: 0, xp: 0 }))),
+      )
+        .post(PATH)
+        .send({ yandexPlayerId: PLAYER, evidence: evidence() })
+        .expect(422, { error: status });
+    },
+  );
+
+  it.each([
+    ["no id", { evidence: evidence() }],
+    ["no evidence", { yandexPlayerId: PLAYER }],
+    [
+      "a string day count",
+      { yandexPlayerId: PLAYER, evidence: evidence({ daysPlayed: "12" }) },
+    ],
+    [
+      "a negative day count",
+      { yandexPlayerId: PLAYER, evidence: evidence({ daysPlayed: -1 }) },
+    ],
+  ])("400 on a malformed body (%s)", async (_label, body) => {
+    const tenureGrant = mockTenureGrant();
+    await request(appWith(tenureGrant))
+      .post(PATH)
+      .send(body)
+      .expect(400, { error: "bad_request" });
+    expect(tenureGrant.grantTenureXp).not.toHaveBeenCalled();
+  });
+
+  it("500 when the repository throws", async () => {
+    await request(appWith(mockTenureGrant(new Error("db down"))))
+      .post(PATH)
+      .send({ yandexPlayerId: PLAYER, evidence: evidence() })
+      .expect(500, { error: "internal_error" });
+  });
+
+  it("503 fail-closed without a repository", async () => {
+    await request(appWith(null))
+      .post(PATH)
+      .send({ yandexPlayerId: PLAYER, evidence: evidence() })
+      .expect(503, { error: "tenure_grant_unavailable" });
+  });
+
+  it("OPTIONS preflight → 204 with CORS headers", async () => {
+    const res = await request(appWith()).options(PATH).expect(204);
+    expect(res.headers["access-control-allow-origin"]).toBe("*");
+    expect(res.headers["access-control-allow-methods"]).toBe("POST");
+    expect(res.headers["access-control-allow-headers"]).toBe("Content-Type");
+  });
+
+  it("CORS header is present on errors too, so the browser can read them", async () => {
+    const res = await request(appWith(null))
+      .post(PATH)
+      .send({ yandexPlayerId: PLAYER, evidence: evidence() })
+      .expect(503);
+    expect(res.headers["access-control-allow-origin"]).toBe("*");
+  });
+});
