@@ -0,0 +1,433 @@
+/**
+ * @jest-environment jsdom
+ */
+// Client claim of the tenure XP grant (task 0253). Pins ADR-112's ack-before-
+// marker rule: the device marker and the modal follow a server answer, never a
+// failure.
+
+jest.mock("../../src/core/configuration/ConfigLoader", () => ({
+  getServerConfigFromClient: jest.fn(),
+}));
+jest.mock("../../src/client/flashist/FlashistFacade", () => ({
+  flashistConstants: {
+    analyticEvents: {
+      CITIZENSHIP_TENURE_GRANT_CLAIMED: "Citizenship:TenureGrant:Claimed",
+      CITIZENSHIP_TENURE_GRANT_REJECTED: "Citizenship:TenureGrant:Rejected",
+      CITIZENSHIP_TENURE_GRANT_CLAIM_FAILED:
+        "Citizenship:TenureGrant:ClaimFailed",
+      PLAYER_DAYS_PLAYED: "Player:DaysPlayed",
+    },
+  },
+  flashist_logEventAnalytics: jest.fn(),
+}));
+
+import { getServerConfigFromClient } from "../../src/core/configuration/ConfigLoader";
+import type { StorageLike } from "../../src/client/DaysPlayedAnalytics";
+import { flashist_logEventAnalytics } from "../../src/client/flashist/FlashistFacade";
+import {
+  TENURE_GRANT_MARKER_KEY,
+  maybeClaimTenureGrant,
+} from "../../src/client/TenureGrantClaim";
+import { TENURE_SNAPSHOT_KEY } from "../../src/client/TenureEvidence";
+import {
+  TENURE_EVIDENCE_FLOOR_MS,
+  TENURE_WINDOW_OPENS_AT_MS,
+  TenureGrantRequestSchema,
+  evaluateTenureClaim,
+} from "../../src/core/profile/TenureGrantContract";
+
+const getServerConfig = getServerConfigFromClient as jest.Mock;
+const logEvent = flashist_logEventAnalytics as jest.Mock;
+const API_BASE = "https://api.example.test";
+const PLAYER = "yandex-1";
+const DAY_MS = 24 * 60 * 60 * 1000;
+// In the past: the client clamps a snapshot later than its own clock (review R1).
+const TAKEN_AT = Date.now() - 2 * DAY_MS;
+
+function makeStorage(initial: Record<string, string> = {}): StorageLike & {
+  data: Record<string, string>;
+} {
+  const data = { ...initial };
+  return {
+    data,
+    getItem: (key) => data[key] ?? null,
+    setItem: (key, value) => {
+      data[key] = value;
+    },
+  };
+}
+
+/** A device with a snapshot of `daysPlayed` days, first seen long before. */
+function deviceWith(daysPlayed: number, extra: Record<string, string> = {}) {
+  return makeStorage({
+    [TENURE_SNAPSHOT_KEY]: JSON.stringify({ daysPlayed, takenAt: TAKEN_AT }),
+    "geoconflict.player.firstSeen": String(TAKEN_AT - 300 * DAY_MS),
+    ...extra,
+  });
+}
+
+function stubFetch(status: number, body: unknown): jest.Mock {
+  const fetchMock = jest.fn().mockResolvedValue({
+    ok: status >= 200 && status < 300,
+    status,
+    json: async () => body,
+  });
+  global.fetch = fetchMock as unknown as typeof fetch;
+  return fetchMock;
+}
+
+function mountModal(): jest.Mock {
+  const show = jest.fn();
+  const element = document.createElement("tenure-grant-modal");
+  Object.assign(element, { show });
+  document.body.appendChild(element);
+  return show;
+}
+
+describe("maybeClaimTenureGrant", () => {
+  let show: jest.Mock;
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    document.body.innerHTML = "";
+    show = mountModal();
+    getServerConfig.mockResolvedValue({ profileApiUrl: () => API_BASE });
+  });
+
+  afterEach(() => {
+    delete (global as { fetch?: unknown }).fetch;
+  });
+
+  describe("early stops — no request", () => {
+    it("an existing marker sends nothing", async () => {
+      const fetchMock = stubFetch(200, {});
+      const storage = deviceWith(20, { [TENURE_GRANT_MARKER_KEY]: "granted" });
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "skipped",
+      });
+      expect(fetchMock).not.toHaveBeenCalled();
+      expect(logEvent).not.toHaveBeenCalled();
+    });
+
+    it("a guest (no Yandex id) sends nothing and sees no modal", async () => {
+      const fetchMock = stubFetch(200, {});
+      const storage = deviceWith(20);
+      await expect(maybeClaimTenureGrant(null, storage)).resolves.toEqual({
+        status: "skipped",
+      });
+      expect(fetchMock).not.toHaveBeenCalled();
+      expect(show).not.toHaveBeenCalled();
+      expect(storage.data[TENURE_GRANT_MARKER_KEY]).toBeUndefined();
+    });
+
+    it("no snapshot sends nothing", async () => {
+      const fetchMock = stubFetch(200, {});
+      await expect(
+        maybeClaimTenureGrant(PLAYER, makeStorage()),
+      ).resolves.toEqual({ status: "skipped" });
+      expect(fetchMock).not.toHaveBeenCalled();
+    });
+
+    it("an empty profileApiUrl sends nothing", async () => {
+      getServerConfig.mockResolvedValue({ profileApiUrl: () => "" });
+      const fetchMock = stubFetch(200, {});
+      await expect(
+        maybeClaimTenureGrant(PLAYER, deviceWith(20)),
+      ).resolves.toEqual({ status: "skipped" });
+      expect(fetchMock).not.toHaveBeenCalled();
+    });
+
+    it("below the minimum locally: marker set, BelowMinimum logged, no request", async () => {
+      const fetchMock = stubFetch(200, {});
+      const storage = deviceWith(2);
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "rejected",
+        reason: "below_minimum",
+      });
+      expect(fetchMock).not.toHaveBeenCalled();
+      expect(storage.data[TENURE_GRANT_MARKER_KEY]).toBe("below_minimum");
+      expect(logEvent).toHaveBeenCalledWith(
+        "Citizenship:TenureGrant:Rejected:BelowMinimum",
+      );
+    });
+  });
+
+  describe("server acks", () => {
+    it("granted: posts id + evidence, then marker, Claimed(value) and the modal", async () => {
+      const fetchMock = stubFetch(200, {
+        status: "granted",
+        xpAwarded: 20,
+        xp: 27,
+      });
+      const storage = deviceWith(20);
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "granted",
+        days: 20,
+        xpAwarded: 20,
+        xp: 27,
+      });
+      expect(fetchMock).toHaveBeenCalledWith(
+        `${API_BASE}/v1/profile/tenure-grant`,
+        expect.objectContaining({ method: "POST" }),
+      );
+      const body = JSON.parse(fetchMock.mock.calls[0][1].body);
+      expect(body).toEqual({
+        yandexPlayerId: PLAYER,
+        evidence: {
+          daysPlayed: 20,
+          gameRecordDays: 0,
+          firstPlayedAt: TAKEN_AT - 300 * DAY_MS,
+          snapshotTakenAt: TAKEN_AT,
+        },
+      });
+      expect(body).not.toHaveProperty("xpAwarded");
+      expect(storage.data[TENURE_GRANT_MARKER_KEY]).toBe("granted");
+      expect(logEvent).toHaveBeenCalledWith(
+        "Citizenship:TenureGrant:Claimed",
+        20,
+      );
+      expect(show).toHaveBeenCalledWith({ days: 20, xpAwarded: 20, xp: 27 });
+    });
+
+    it("the marker is written BEFORE the modal opens", async () => {
+      stubFetch(200, { status: "granted", xpAwarded: 5, xp: 5 });
+      const storage = deviceWith(5);
+      let markerAtShow: string | undefined;
+      show.mockImplementation(() => {
+        markerAtShow = storage.data[TENURE_GRANT_MARKER_KEY];
+      });
+      await maybeClaimTenureGrant(PLAYER, storage);
+      expect(markerAtShow).toBe("granted");
+    });
+
+    it("a modal that throws does not turn a grant into a failure", async () => {
+      stubFetch(200, { status: "granted", xpAwarded: 5, xp: 5 });
+      show.mockImplementation(() => {
+        throw new Error("render failed");
+      });
+      const storage = deviceWith(5);
+      await expect(
+        maybeClaimTenureGrant(PLAYER, storage),
+      ).resolves.toMatchObject({ status: "granted" });
+      expect(logEvent).not.toHaveBeenCalledWith(
+        "Citizenship:TenureGrant:ClaimFailed",
+      );
+    });
+
+    it("a lost-ack duplicate on an unmarked device still shows the modal", async () => {
+      stubFetch(200, { status: "duplicate", xpAwarded: 30, xp: 41 });
+      const storage = deviceWith(30);
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "duplicate",
+        days: 30,
+        xpAwarded: 30,
+        xp: 41,
+      });
+      expect(storage.data[TENURE_GRANT_MARKER_KEY]).toBe("duplicate");
+      expect(logEvent).toHaveBeenCalledWith(
+        "Citizenship:TenureGrant:Rejected:Duplicate",
+      );
+      expect(logEvent).not.toHaveBeenCalledWith(
+        "Citizenship:TenureGrant:Claimed",
+        expect.anything(),
+      );
+      expect(show).toHaveBeenCalledWith({ days: 30, xpAwarded: 30, xp: 41 });
+    });
+
+    it("the modal's day count is clamped the way the server clamps it", async () => {
+      stubFetch(200, { status: "granted", xpAwarded: 3, xp: 3 });
+      // Counter says 40, but the device was first seen 2 days before the snapshot.
+      const storage = deviceWith(40, {
+        "geoconflict.player.firstSeen": String(TAKEN_AT - 2 * DAY_MS),
+      });
+      await maybeClaimTenureGrant(PLAYER, storage);
+      expect(show).toHaveBeenCalledWith({ days: 3, xpAwarded: 3, xp: 3 });
+    });
+  });
+
+  // Review R1/R2 (round 1): what the client posts must be something the server
+  // can accept — an out-of-range date or a negative count would come back as a
+  // permanent `implausible` (burning the claim) or a 400 retried forever.
+  describe("posted evidence is always acceptable to the server", () => {
+    const serverNow = Math.max(TENURE_WINDOW_OPENS_AT_MS, TAKEN_AT) + DAY_MS;
+
+    async function postedEvidence(storage: StorageLike) {
+      const fetchMock = stubFetch(200, {
+        status: "granted",
+        xpAwarded: 5,
+        xp: 5,
+      });
+      await maybeClaimTenureGrant(PLAYER, storage);
+      expect(fetchMock).toHaveBeenCalledTimes(1);
+      return JSON.parse(fetchMock.mock.calls[0][1].body);
+    }
+
+    it("a pre-floor firstSeen (wrong clock) is not sent", async () => {
+      const body = await postedEvidence(
+        deviceWith(20, {
+          "geoconflict.player.firstSeen": String(
+            TENURE_EVIDENCE_FLOOR_MS - DAY_MS,
+          ),
+        }),
+      );
+      expect(evaluateTenureClaim(body.evidence, serverNow).ok).toBe(true);
+    });
+
+    it("a pre-floor game record (wrong clock) is not sent", async () => {
+      const body = await postedEvidence(
+        deviceWith(20, {
+          "game-records": JSON.stringify({
+            g: { startTime: TENURE_EVIDENCE_FLOOR_MS - DAY_MS },
+          }),
+        }),
+      );
+      expect(evaluateTenureClaim(body.evidence, serverNow).ok).toBe(true);
+    });
+
+    it("a negative snapshot counter never produces a 400-shaped body", async () => {
+      const day = (n: number) => TAKEN_AT - n * DAY_MS;
+      const body = await postedEvidence(
+        makeStorage({
+          [TENURE_SNAPSHOT_KEY]: JSON.stringify({
+            daysPlayed: -5,
+            takenAt: TAKEN_AT,
+          }),
+          "game-records": JSON.stringify({
+            a: { startTime: day(3) },
+            b: { startTime: day(5) },
+            c: { startTime: day(7) },
+          }),
+        }),
+      );
+      expect(TenureGrantRequestSchema.safeParse(body).success).toBe(true);
+    });
+  });
+
+  describe("server rejections", () => {
+    it.each([
+      ["below_minimum", "BelowMinimum"],
+      ["implausible", "Implausible"],
+      ["window_closed", "WindowClosed"],
+    ])("%s is permanent: marker set, no modal", async (reason, suffix) => {
+      stubFetch(422, { error: reason });
+      const storage = deviceWith(20);
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "rejected",
+        reason,
+      });
+      expect(storage.data[TENURE_GRANT_MARKER_KEY]).toBe(reason);
+      expect(logEvent).toHaveBeenCalledWith(
+        `Citizenship:TenureGrant:Rejected:${suffix}`,
+      );
+      expect(show).not.toHaveBeenCalled();
+    });
+
+    it.each([
+      ["no_profile", "NoProfile"],
+      ["no_credited_match", "NoCreditedMatch"],
+      ["window_not_open", "WindowNotOpen"],
+    ])(
+      "%s is temporary: NO marker, retried next load",
+      async (reason, suffix) => {
+        stubFetch(422, { error: reason });
+        const storage = deviceWith(20);
+        await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+          status: "rejected",
+          reason,
+        });
+        expect(storage.data[TENURE_GRANT_MARKER_KEY]).toBeUndefined();
+        expect(logEvent).toHaveBeenCalledWith(
+          `Citizenship:TenureGrant:Rejected:${suffix}`,
+        );
+        expect(show).not.toHaveBeenCalled();
+      },
+    );
+  });
+
+  describe("failures — never a marker (verification 9)", () => {
+    function expectFailedWithoutMarker(
+      storage: ReturnType<typeof deviceWith>,
+    ): void {
+      expect(storage.data[TENURE_GRANT_MARKER_KEY]).toBeUndefined();
+      expect(logEvent).toHaveBeenCalledWith(
+        "Citizenship:TenureGrant:ClaimFailed",
+      );
+      expect(show).not.toHaveBeenCalled();
+    }
+
+    it("a network error", async () => {
+      global.fetch = jest
+        .fn()
+        .mockRejectedValue(new TypeError("Failed to fetch")) as never;
+      const storage = deviceWith(20);
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "failed",
+      });
+      expectFailedWithoutMarker(storage);
+    });
+
+    it("a timeout (aborted fetch)", async () => {
+      jest.useFakeTimers();
+      try {
+        global.fetch = jest.fn(
+          (_url: string, init: RequestInit) =>
+            new Promise((_resolve, reject) => {
+              init.signal?.addEventListener("abort", () =>
+                reject(new DOMException("aborted", "AbortError")),
+              );
+            }),
+        ) as never;
+        const storage = deviceWith(20);
+        const pending = maybeClaimTenureGrant(PLAYER, storage);
+        await jest.advanceTimersByTimeAsync(10_000);
+        await expect(pending).resolves.toEqual({ status: "failed" });
+        expectFailedWithoutMarker(storage);
+      } finally {
+        jest.useRealTimers();
+      }
+    });
+
+    it.each([500, 502, 503, 429, 400])("HTTP %i", async (status) => {
+      stubFetch(status, { error: "whatever" });
+      const storage = deviceWith(20);
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "failed",
+      });
+      expectFailedWithoutMarker(storage);
+    });
+
+    it.each([
+      ["a non-JSON 200", null],
+      [
+        "a 200 with an unknown status",
+        { status: "maybe", xpAwarded: 1, xp: 1 },
+      ],
+      ["a 200 missing fields", { status: "granted" }],
+    ])("%s", async (_label, body) => {
+      stubFetch(200, body);
+      const storage = deviceWith(20);
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "failed",
+      });
+      expectFailedWithoutMarker(storage);
+    });
+
+    it("a 422 with an unknown reason", async () => {
+      stubFetch(422, { error: "brand_new_reason" });
+      const storage = deviceWith(20);
+      await expect(maybeClaimTenureGrant(PLAYER, storage)).resolves.toEqual({
+        status: "failed",
+      });
+      expectFailedWithoutMarker(storage);
+    });
+
+    it("config loading throws", async () => {
+      getServerConfig.mockRejectedValue(new Error("no env"));
+      const fetchMock = stubFetch(200, {});
+      await expect(
+        maybeClaimTenureGrant(PLAYER, deviceWith(20)),
+      ).resolves.toEqual({ status: "skipped" });
+      expect(fetchMock).not.toHaveBeenCalled();
+    });
+  });
+});
