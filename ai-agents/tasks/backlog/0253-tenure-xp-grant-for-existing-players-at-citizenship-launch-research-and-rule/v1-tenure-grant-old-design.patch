+++ b/src/client/TenureGrantModal.ts
@@ -0,0 +1,129 @@
+import { LitElement, css, html } from "lit";
+import { customElement, state } from "lit/decorators.js";
+import { CITIZENSHIP_XP_THRESHOLD } from "../core/profile/Citizenship";
+import { translateText } from "./Utils";
+
+export interface TenureGrantModalParams {
+  /** Pre-launch days the grant was based on. */
+  days: number;
+  /** XP the grant added. */
+  xpAwarded: number;
+  /** The player's XP total after the grant. */
+  xp: number;
+}
+
+/**
+ * One-time "thank you" notice for the tenure XP grant (task 0253, ADR-112).
+ * Opened by TenureGrantClaim only after the SERVER confirmed the grant, and only
+ * reachable behind the citizenship kill switch. Follows GameStartingModal.
+ */
+@customElement("tenure-grant-modal")
+export class TenureGrantModal extends LitElement {
+  @state()
+  isVisible = false;
+
+  @state()
+  private params: TenureGrantModalParams | null = null;
+
+  static styles = css`
+    .modal-overlay {
+      display: none;
+      position: fixed;
+      inset: 0;
+      background-color: rgba(0, 0, 0, 0.5);
+      z-index: 9999;
+      align-items: center;
+      justify-content: center;
+    }
+
+    .modal-overlay.visible {
+      display: flex;
+      animation: fadeIn 0.3s ease-out;
+    }
+
+    @keyframes fadeIn {
+      from {
+        opacity: 0;
+      }
+      to {
+        opacity: 1;
+      }
+    }
+
+    .modal-box {
+      background-color: rgba(28, 28, 30, 0.95);
+      padding: 24px;
+      border-radius: 12px;
+      box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
+      color: white;
+      width: 320px;
+      max-width: 90vw;
+      text-align: center;
+    }
+
+    .modal-box h2 {
+      margin: 0 0 12px;
+      font-size: 20px;
+      font-weight: bold;
+    }
+
+    .modal-box p {
+      margin: 0 0 20px;
+      font-size: 14px;
+      line-height: 1.45;
+      color: rgba(255, 255, 255, 0.85);
+    }
+
+    .modal-box button {
+      width: 100%;
+      padding: 12px;
+      font-size: 16px;
+      font-weight: bold;
+      cursor: pointer;
+      background: #2563eb;
+      color: white;
+      border: none;
+      border-radius: 8px;
+      transition: background-color 0.2s ease;
+    }
+
+    .modal-box button:hover {
+      background: #1d4ed8;
+    }
+  `;
+
+  render() {
+    const params = this.params;
+    return html`
+      <div class="modal-overlay ${this.isVisible ? "visible" : ""}">
+        <div class="modal-box" role="dialog" aria-modal="true">
+          <h2>${translateText("citizenship_tenure_grant.title")}</h2>
+          <p>
+            ${params === null
+              ? ""
+              : translateText("citizenship_tenure_grant.body", {
+                  days: params.days,
+                  xp: params.xpAwarded,
+                  total: params.xp,
+                  threshold: CITIZENSHIP_XP_THRESHOLD,
+                })}
+          </p>
+          <button id="tenure-grant-modal-cta" @click=${this.hide}>
+            ${translateText("citizenship_tenure_grant.cta")}
+          </button>
+        </div>
+      </div>
+    `;
+  }
+
+  show(params: TenureGrantModalParams) {
+    this.params = params;
+    this.isVisible = true;
+    this.requestUpdate();
+  }
+
+  hide() {
+    this.isVisible = false;
+    this.requestUpdate();
+  }
+}
diff --git a/src/core/profile/TenureGrantContract.ts b/src/core/profile/TenureGrantContract.ts
new file mode 100644
index 0000000..34b23f2
--- /dev/null
+++ b/src/core/profile/TenureGrantContract.ts
@@ -0,0 +1,169 @@
+import { z } from "zod";
+import {
+  TENURE_MIN_DAYS,
+  TENURE_XP_CAP,
+  TENURE_XP_PER_DAY,
+} from "./Citizenship";
+
+/**
+ * Shared client↔profile-server contract and pure rules for the one-time tenure
+ * XP grant (task 0253): `POST /v1/profile/tenure-grant`. Sibling of
+ * NameChangeContract.ts — the client posts, and the server validates and
+ * evaluates, exactly the shapes and rules defined here. No I/O; the clock is a
+ * parameter.
+ *
+ * The policy is ADR-112: the evidence comes from the player's own device
+ * (localStorage), so the server cannot verify it — it can only bound the harm
+ * of a false claim. It does so by computing the amount ITSELF (a client-sent
+ * amount is never read), clamping the day count to what is physically possible,
+ * capping the result, and recording at most one grant per account.
+ *
+ * "Pre-launch" means before this device first ran the grant build: the client
+ * takes a one-time snapshot of `daysPlayed` on that first boot, and only
+ * `game-records` entries older than the snapshot count (see TenureEvidence.ts).
+ */
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/**
+ * No player can hold evidence older than the fork itself: the first commit is
+ * 2025-11-04 (+03:00). Floored to that day's local midnight, so it is EARLIER
+ * than the commit and never rejects an honest record.
+ */
+export const TENURE_EVIDENCE_FLOOR_MS = Date.UTC(2025, 10, 3, 21, 0, 0);
+
+/**
+ * The claim window opens on the weekend deploy day — 2026-09-19 00:00 Moscow
+ * time (UTC+3), owner ruling 1 at plan approval, 2026-09-14.
+ */
+export const TENURE_WINDOW_OPENS_AT_MS = Date.UTC(2026, 8, 18, 21, 0, 0);
+
+/** The window stays open this many days after it opens (ruling C). */
+export const TENURE_CLAIM_WINDOW_DAYS = 90;
+
+export const TENURE_WINDOW_CLOSES_AT_MS =
+  TENURE_WINDOW_OPENS_AT_MS + TENURE_CLAIM_WINDOW_DAYS * DAY_MS;
+
+/** A snapshot more than this far in the future is a clock the server rejects. */
+const FUTURE_TOLERANCE_MS = DAY_MS;
+
+const MAX_DAY_COUNT = 100_000;
+
+export const TenureEvidenceSchema = z.object({
+  /** `geoconflict.player.daysPlayed` as it was when the snapshot was taken. */
+  daysPlayed: z.number().int().min(0).max(MAX_DAY_COUNT),
+  /** Distinct local calendar days in `game-records` before the snapshot. */
+  gameRecordDays: z.number().int().min(0).max(MAX_DAY_COUNT),
+  /** Earliest known play timestamp (ms), or null when the device has none. */
+  firstPlayedAt: z.number().int().nullable(),
+  /** When this device first ran the grant build (ms). */
+  snapshotTakenAt: z.number().int(),
+});
+export type TenureEvidence = z.infer<typeof TenureEvidenceSchema>;
+
+export const TenureGrantRequestSchema = z.object({
+  yandexPlayerId: z.string().min(1).max(128),
+  evidence: TenureEvidenceSchema,
+});
+export type TenureGrantRequest = z.infer<typeof TenureGrantRequestSchema>;
+
+/**
+ * 200 body. `duplicate` means this account already holds its grant — the stored
+ * amount is returned, and nothing was added.
+ */
+export const TenureGrantResponseSchema = z.object({
+  status: z.enum(["granted", "duplicate"]),
+  xpAwarded: z.number().int(),
+  xp: z.number().int(),
+});
+export type TenureGrantResponse = z.infer<typeof TenureGrantResponseSchema>;
+
+export const TENURE_REJECTION_REASONS = [
+  "below_minimum",
+  "implausible",
+  "window_not_open",
+  "window_closed",
+  "no_profile",
+  "no_credited_match",
+] as const;
+export const TenureRejectionReasonSchema = z.enum(TENURE_REJECTION_REASONS);
+export type TenureRejectionReason = z.infer<typeof TenureRejectionReasonSchema>;
+
+/** 422 body. */
+export const TenureGrantRejectionSchema = z.object({
+  error: TenureRejectionReasonSchema,
+});
+
+export type TenureClaimEvaluation =
+  | { ok: true; days: number; xpAwarded: number }
+  | {
+      ok: false;
+      reason: Extract<
+        TenureRejectionReason,
+        "below_minimum" | "implausible" | "window_not_open" | "window_closed"
+      >;
+    };
+
+/**
+ * The day count the evidence supports: the larger of the two signals (ruling A),
+ * clamped to the number of calendar days that can fit between the earliest
+ * possible play and the snapshot (decision 5).
+ *
+ * The span is rounded UP and then counts both end days, so an honest player can
+ * never be clamped below their real count: two local calendar days can sit
+ * minutes apart across midnight. Clamping can only LOWER the raw count, which is
+ * why a raw count below the minimum is already final (the client relies on it).
+ *
+ * Assumes plausible timestamps — call it after the checks in evaluateTenureClaim.
+ */
+export function tenureDaysFromEvidence(evidence: TenureEvidence): number {
+  const rawDays = Math.max(evidence.daysPlayed, evidence.gameRecordDays);
+  const spanStart = Math.max(
+    TENURE_EVIDENCE_FLOOR_MS,
+    evidence.firstPlayedAt ?? TENURE_EVIDENCE_FLOOR_MS,
+  );
+  const possibleDays =
+    Math.ceil(Math.max(0, evidence.snapshotTakenAt - spanStart) / DAY_MS) + 1;
+  return Math.min(rawDays, possibleDays);
+}
+
+/** XP for a day count: per-day rate, capped. */
+export function tenureXpForDays(days: number): number {
+  return Math.min(days * TENURE_XP_PER_DAY, TENURE_XP_CAP);
+}
+
+/**
+ * Evaluate a claim, in this order: window → timestamps → days → minimum →
+ * amount. Only impossible timestamps are rejected; merely generous day counts
+ * are clamped, then capped (decision 5).
+ */
+export function evaluateTenureClaim(
+  evidence: TenureEvidence,
+  nowMs: number,
+): TenureClaimEvaluation {
+  if (nowMs < TENURE_WINDOW_OPENS_AT_MS) {
+    return { ok: false, reason: "window_not_open" };
+  }
+  if (nowMs >= TENURE_WINDOW_CLOSES_AT_MS) {
+    return { ok: false, reason: "window_closed" };
+  }
+
+  const { firstPlayedAt, snapshotTakenAt } = evidence;
+  if (
+    snapshotTakenAt > nowMs + FUTURE_TOLERANCE_MS ||
+    // A snapshot older than the fork is as impossible as a first play older
+    // than it; without this the span below would go negative.
+    snapshotTakenAt < TENURE_EVIDENCE_FLOOR_MS ||
+    (firstPlayedAt !== null &&
+      (firstPlayedAt < TENURE_EVIDENCE_FLOOR_MS ||
+        firstPlayedAt > snapshotTakenAt))
+  ) {
+    return { ok: false, reason: "implausible" };
+  }
+
+  const days = tenureDaysFromEvidence(evidence);
+  if (days < TENURE_MIN_DAYS) {
+    return { ok: false, reason: "below_minimum" };
+  }
+  return { ok: true, days, xpAwarded: tenureXpForDays(days) };
+}
