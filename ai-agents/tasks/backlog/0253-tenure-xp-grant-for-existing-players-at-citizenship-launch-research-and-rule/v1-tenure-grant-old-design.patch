+/**
+ * @jest-environment jsdom
+ */
+// Task 0253: FlashistFacade.initializeImmediate() must take the tenure snapshot
+// BEFORE logDaysPlayedAnalytics() adds today — otherwise the first post-launch
+// day leaks into "pre-launch". Drives the REAL method over jsdom localStorage.
+
+import { FlashistFacade } from "../../src/client/flashist/FlashistFacade";
+
+const DAYS_PLAYED_KEY = "geoconflict.player.daysPlayed";
+const LAST_PLAYED_KEY = "geoconflict.player.lastPlayedDate";
+const SNAPSHOT_KEY = "geoconflict.player.tenureSnapshot";
+
+describe("initializeImmediate tenure snapshot ordering", () => {
+  beforeEach(() => {
+    localStorage.clear();
+    window.matchMedia = jest.fn().mockReturnValue({
+      matches: false,
+    }) as unknown as typeof window.matchMedia;
+    jest.spyOn(console, "log").mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  function freshFacade(): FlashistFacade {
+    // Constructor skipped (it runs platform detection); only the field the
+    // method reads is seeded.
+    return Object.assign(Object.create(FlashistFacade.prototype), {
+      yaGamesAvailable: false,
+    }) as FlashistFacade;
+  }
+
+  it("snapshots yesterday's count, then the counter moves on to today", () => {
+    localStorage.setItem(DAYS_PLAYED_KEY, "7");
+    localStorage.setItem(LAST_PLAYED_KEY, "2000-01-01");
+
+    freshFacade().initializeImmediate();
+
+    expect(localStorage.getItem(DAYS_PLAYED_KEY)).toBe("8");
+    expect(JSON.parse(localStorage.getItem(SNAPSHOT_KEY)!).daysPlayed).toBe(7);
+  });
+
+  it("a later boot never moves the snapshot", () => {
+    localStorage.setItem(DAYS_PLAYED_KEY, "7");
+    localStorage.setItem(LAST_PLAYED_KEY, "2000-01-01");
+    freshFacade().initializeImmediate();
+    const first = localStorage.getItem(SNAPSHOT_KEY);
+
+    localStorage.setItem(LAST_PLAYED_KEY, "2000-01-02");
+    freshFacade().initializeImmediate();
+
+    expect(localStorage.getItem(DAYS_PLAYED_KEY)).toBe("9");
+    expect(localStorage.getItem(SNAPSHOT_KEY)).toBe(first);
+  });
+});
diff --git a/tests/core/profile/TenureGrantContract.test.ts b/tests/core/profile/TenureGrantContract.test.ts
new file mode 100644
index 0000000..92744fd
--- /dev/null
+++ b/tests/core/profile/TenureGrantContract.test.ts
@@ -0,0 +1,298 @@
+import {
+  TENURE_CLAIM_WINDOW_DAYS,
+  TENURE_EVIDENCE_FLOOR_MS,
+  TENURE_WINDOW_CLOSES_AT_MS,
+  TENURE_WINDOW_OPENS_AT_MS,
+  TenureGrantRejectionSchema,
+  TenureGrantRequestSchema,
+  TenureGrantResponseSchema,
+  evaluateTenureClaim,
+  tenureDaysFromEvidence,
+  tenureXpForDays,
+  type TenureEvidence,
+} from "../../../src/core/profile/TenureGrantContract";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+// Inside the claim window.
+const NOW = TENURE_WINDOW_OPENS_AT_MS + 10 * DAY_MS;
+// A device that has been around for 300 days before its snapshot.
+const SNAPSHOT = NOW - DAY_MS;
+const FIRST_PLAYED = SNAPSHOT - 300 * DAY_MS;
+
+function evidence(overrides: Partial<TenureEvidence> = {}): TenureEvidence {
+  return {
+    daysPlayed: 10,
+    gameRecordDays: 0,
+    firstPlayedAt: FIRST_PLAYED,
+    snapshotTakenAt: SNAPSHOT,
+    ...overrides,
+  };
+}
+
+describe("tenure grant constants", () => {
+  test("the window opens 2026-09-19 00:00 Moscow time (UTC+3)", () => {
+    expect(new Date(TENURE_WINDOW_OPENS_AT_MS).toISOString()).toBe(
+      "2026-09-18T21:00:00.000Z",
+    );
+  });
+
+  test("the window closes exactly 90 days later", () => {
+    expect(TENURE_CLAIM_WINDOW_DAYS).toBe(90);
+    expect(TENURE_WINDOW_CLOSES_AT_MS - TENURE_WINDOW_OPENS_AT_MS).toBe(
+      90 * DAY_MS,
+    );
+  });
+
+  test("the evidence floor is no later than the fork's first commit", () => {
+    // First commit: 2025-11-04 14:31:02 +03:00.
+    expect(TENURE_EVIDENCE_FLOOR_MS).toBeLessThanOrEqual(
+      Date.parse("2025-11-04T14:31:02+03:00"),
+    );
+    expect(new Date(TENURE_EVIDENCE_FLOOR_MS).toISOString()).toBe(
+      "2025-11-03T21:00:00.000Z",
+    );
+  });
+});
+
+describe("evaluateTenureClaim — days and amount", () => {
+  test("uses the larger of daysPlayed and gameRecordDays", () => {
+    expect(
+      evaluateTenureClaim(evidence({ daysPlayed: 4, gameRecordDays: 9 }), NOW),
+    ).toEqual({ ok: true, days: 9, xpAwarded: 9 });
+    expect(
+      evaluateTenureClaim(evidence({ daysPlayed: 12, gameRecordDays: 5 }), NOW),
+    ).toEqual({ ok: true, days: 12, xpAwarded: 12 });
+  });
+
+  test("minimum is 3 days: 2 is rejected, 3 grants 3 XP", () => {
+    expect(evaluateTenureClaim(evidence({ daysPlayed: 2 }), NOW)).toEqual({
+      ok: false,
+      reason: "below_minimum",
+    });
+    expect(evaluateTenureClaim(evidence({ daysPlayed: 3 }), NOW)).toEqual({
+      ok: true,
+      days: 3,
+      xpAwarded: 3,
+    });
+  });
+
+  test("zero evidence is below the minimum", () => {
+    expect(
+      evaluateTenureClaim(
+        evidence({ daysPlayed: 0, gameRecordDays: 0, firstPlayedAt: null }),
+        NOW,
+      ),
+    ).toEqual({ ok: false, reason: "below_minimum" });
+  });
+
+  test("caps the amount at 50 XP (80 days → 50)", () => {
+    expect(evaluateTenureClaim(evidence({ daysPlayed: 80 }), NOW)).toEqual({
+      ok: true,
+      days: 80,
+      xpAwarded: 50,
+    });
+    expect(tenureXpForDays(50)).toBe(50);
+    expect(tenureXpForDays(51)).toBe(50);
+  });
+
+  test("clamps the day count to the span between first play and snapshot", () => {
+    // First played 4 days (and a bit) before the snapshot → at most 6 calendar
+    // days can be touched, whatever the counter claims.
+    const firstPlayedAt = SNAPSHOT - 4 * DAY_MS - 60_000;
+    expect(
+      evaluateTenureClaim(evidence({ daysPlayed: 500, firstPlayedAt }), NOW),
+    ).toEqual({ ok: true, days: 6, xpAwarded: 6 });
+  });
+
+  test("the clamp never undercounts two calendar days minutes apart", () => {
+    // 23:55 one day, 00:05 the next: 10 minutes, but two local dates.
+    const firstPlayedAt = SNAPSHOT - 10 * 60_000;
+    expect(
+      tenureDaysFromEvidence(evidence({ daysPlayed: 2, firstPlayedAt })),
+    ).toBe(2);
+    // Same instant: one day.
+    expect(
+      tenureDaysFromEvidence(
+        evidence({ daysPlayed: 2, firstPlayedAt: SNAPSHOT }),
+      ),
+    ).toBe(1);
+  });
+
+  test("with no firstPlayedAt, the span starts at the evidence floor", () => {
+    const snapshotTakenAt = TENURE_EVIDENCE_FLOOR_MS + 5 * DAY_MS;
+    expect(
+      tenureDaysFromEvidence(
+        evidence({ daysPlayed: 100, firstPlayedAt: null, snapshotTakenAt }),
+      ),
+    ).toBe(6);
+  });
+
+  test("clamping below the minimum turns into below_minimum", () => {
+    expect(
+      evaluateTenureClaim(
+        evidence({ daysPlayed: 40, firstPlayedAt: SNAPSHOT - 60_000 }),
+        NOW,
+      ),
+    ).toEqual({ ok: false, reason: "below_minimum" });
+  });
+});
+
+describe("evaluateTenureClaim — implausible timestamps", () => {
+  test("a snapshot more than one day in the future", () => {
+    expect(
+      evaluateTenureClaim(evidence({ snapshotTakenAt: NOW + DAY_MS + 1 }), NOW),
+    ).toEqual({ ok: false, reason: "implausible" });
+    // Exactly one day ahead is tolerated (clock skew).
+    expect(
+      evaluateTenureClaim(evidence({ snapshotTakenAt: NOW + DAY_MS }), NOW).ok,
+    ).toBe(true);
+  });
+
+  test("a first play before the evidence floor", () => {
+    expect(
+      evaluateTenureClaim(
+        evidence({ firstPlayedAt: TENURE_EVIDENCE_FLOOR_MS - 1 }),
+        NOW,
+      ),
+    ).toEqual({ ok: false, reason: "implausible" });
+  });
+
+  test("a first play after the snapshot", () => {
+    expect(
+      evaluateTenureClaim(evidence({ firstPlayedAt: SNAPSHOT + 1 }), NOW),
+    ).toEqual({ ok: false, reason: "implausible" });
+  });
+
+  test("a snapshot before the evidence floor", () => {
+    expect(
+      evaluateTenureClaim(
+        evidence({
+          firstPlayedAt: null,
+          snapshotTakenAt: TENURE_EVIDENCE_FLOOR_MS - 1,
+        }),
+        NOW,
+      ),
+    ).toEqual({ ok: false, reason: "implausible" });
+  });
+
+  test("implausible wins over below_minimum (checked first)", () => {
+    expect(
+      evaluateTenureClaim(
+        evidence({ daysPlayed: 0, firstPlayedAt: SNAPSHOT + 1 }),
+        NOW,
+      ),
+    ).toEqual({ ok: false, reason: "implausible" });
+  });
+});
+
+describe("evaluateTenureClaim — the window edges", () => {
+  test("one millisecond before it opens", () => {
+    expect(
+      evaluateTenureClaim(
+        evidence({ snapshotTakenAt: TENURE_WINDOW_OPENS_AT_MS - DAY_MS }),
+        TENURE_WINDOW_OPENS_AT_MS - 1,
+      ),
+    ).toEqual({ ok: false, reason: "window_not_open" });
+  });
+
+  test("the moment it opens", () => {
+    expect(
+      evaluateTenureClaim(
+        evidence({ snapshotTakenAt: TENURE_WINDOW_OPENS_AT_MS - DAY_MS }),
+        TENURE_WINDOW_OPENS_AT_MS,
+      ).ok,
+    ).toBe(true);
+  });
+
+  test("the last millisecond it is open", () => {
+    expect(
+      evaluateTenureClaim(evidence(), TENURE_WINDOW_CLOSES_AT_MS - 1).ok,
+    ).toBe(true);
+  });
+
+  test("the moment it closes", () => {
+    expect(evaluateTenureClaim(evidence(), TENURE_WINDOW_CLOSES_AT_MS)).toEqual(
+      { ok: false, reason: "window_closed" },
+    );
+  });
+
+  test("the window is checked before the evidence", () => {
+    expect(
+      evaluateTenureClaim(
+        evidence({ daysPlayed: 0, firstPlayedAt: SNAPSHOT + 1 }),
+        TENURE_WINDOW_OPENS_AT_MS - 1,
+      ),
+    ).toEqual({ ok: false, reason: "window_not_open" });
+  });
+});
+
+describe("wire schemas", () => {
+  const valid = { yandexPlayerId: "p1", evidence: evidence() };
+
+  test("accepts a well-formed request", () => {
+    expect(TenureGrantRequestSchema.safeParse(valid).success).toBe(true);
+    expect(
+      TenureGrantRequestSchema.safeParse({
+        ...valid,
+        evidence: evidence({ firstPlayedAt: null }),
+      }).success,
+    ).toBe(true);
+  });
+
+  test.each([
+    ["an empty player id", { ...valid, yandexPlayerId: "" }],
+    ["a 129-char player id", { ...valid, yandexPlayerId: "x".repeat(129) }],
+    [
+      "negative daysPlayed",
+      { ...valid, evidence: evidence({ daysPlayed: -1 }) },
+    ],
+    [
+      "daysPlayed above 100000",
+      { ...valid, evidence: evidence({ daysPlayed: 100_001 }) },
+    ],
+    [
+      "a fractional gameRecordDays",
+      { ...valid, evidence: evidence({ gameRecordDays: 1.5 }) },
+    ],
+    [
+      "gameRecordDays above 100000",
+      { ...valid, evidence: evidence({ gameRecordDays: 100_001 }) },
+    ],
+    ["missing evidence", { yandexPlayerId: "p1" }],
+  ])("rejects %s", (_label, body) => {
+    expect(TenureGrantRequestSchema.safeParse(body).success).toBe(false);
+  });
+
+  test("accepts the bounds themselves", () => {
+    expect(
+      TenureGrantRequestSchema.safeParse({
+        yandexPlayerId: "x".repeat(128),
+        evidence: evidence({ daysPlayed: 100_000, gameRecordDays: 0 }),
+      }).success,
+    ).toBe(true);
+  });
+
+  test("response and rejection shapes", () => {
+    expect(
+      TenureGrantResponseSchema.safeParse({
+        status: "granted",
+        xpAwarded: 10,
+        xp: 12,
+      }).success,
+    ).toBe(true);
+    expect(
+      TenureGrantResponseSchema.safeParse({
+        status: "other",
+        xpAwarded: 1,
+        xp: 1,
+      }).success,
+    ).toBe(false);
+    expect(
+      TenureGrantRejectionSchema.safeParse({ error: "no_credited_match" })
+        .success,
+    ).toBe(true);
+    expect(
+      TenureGrantRejectionSchema.safeParse({ error: "nope" }).success,
+    ).toBe(false);
+  });
+});
diff --git a/tests/integration/TenureGrant.it.test.ts b/tests/integration/TenureGrant.it.test.ts
new file mode 100644
index 0000000..4436497
--- /dev/null
+++ b/tests/integration/TenureGrant.it.test.ts
@@ -0,0 +1,216 @@
+// Integration test for the tenure XP grant (task 0253): the real migrations, a
+// real PlayerProfileRepository and real Postgres, driven through createApp() via
+// supertest. This is where brief verification 8 is PROVEN — the real primary key,
+// the real FK, the real transaction. Gated by RUN_DB_TESTS; see jest.config.ts.
+// supertest-based, so the known flake family applies (CLAUDE.md).
+
+import { readFileSync } from "fs";
+import { join } from "path";
+import { Pool } from "pg";
+import request from "supertest";
+import {
+  TENURE_WINDOW_OPENS_AT_MS,
+  type TenureEvidence,
+} from "../../src/core/profile/TenureGrantContract";
+import { PlayerProfileRepository } from "../../src/profile-server/PlayerProfileRepository";
+import { createApp } from "../../src/profile-server/Routes";
+
+const RUN = process.env.RUN_DB_TESTS ? describe : describe.skip;
+const DAY_MS = 24 * 60 * 60 * 1000;
+// The window opens after this suite was written — pin the clock inside it.
+const NOW = TENURE_WINDOW_OPENS_AT_MS + 3 * DAY_MS;
+
+RUN("tenure XP grant over real Postgres (integration)", () => {
+  let pool: Pool;
+  let repo: PlayerProfileRepository;
+  let app: ReturnType<typeof createApp>;
+
+  const VETERAN = "yandex-tenure-veteran";
+  const FRESH = "yandex-tenure-fresh";
+
+  const evidence = (
+    overrides: Partial<TenureEvidence> = {},
+  ): TenureEvidence => ({
+    daysPlayed: 80,
+    gameRecordDays: 12,
+    firstPlayedAt: NOW - 200 * DAY_MS,
+    snapshotTakenAt: NOW - DAY_MS,
+    ...overrides,
+  });
+
+  const claim = (yandexPlayerId: string, ev: TenureEvidence = evidence()) =>
+    request(app)
+      .post("/v1/profile/tenure-grant")
+      .send({ yandexPlayerId, evidence: ev });
+
+  const credit = (gameId: string, yandexPlayerId: string) =>
+    repo.creditMatchXp(gameId, yandexPlayerId, 1);
+
+  const profileXp = async (yandexPlayerId: string): Promise<number> =>
+    Number(
+      (
+        await pool.query(
+          "SELECT xp FROM player_profiles WHERE yandex_player_id = $1",
+          [yandexPlayerId],
+        )
+      ).rows[0].xp,
+    );
+
+  beforeAll(async () => {
+    pool = new Pool({ connectionString: process.env.TEST_DATABASE_URL });
+    for (const file of [
+      "migrations/001_player_profiles.sql",
+      "migrations/002_yandex_payments.sql",
+      "migrations/003_player_messages.sql",
+      "migrations/004_name_change.sql",
+      "migrations/005_player_xp_grants.sql",
+    ]) {
+      await pool.query(readFileSync(join(process.cwd(), file), "utf8"));
+    }
+  });
+
+  afterAll(async () => {
+    await pool.end();
+  });
+
+  beforeEach(async () => {
+    // Pin Date.now only — pg and supertest keep their real timers.
+    jest.spyOn(Date, "now").mockReturnValue(NOW);
+    // A fresh app per test: createApp builds the per-IP limiter, and every
+    // request here comes from 127.0.0.1.
+    repo = new PlayerProfileRepository(pool);
+    app = createApp(repo, undefined, undefined, undefined, repo);
+    await pool.query(
+      `TRUNCATE player_xp_grants, player_messages, player_match_xp_credits,
+               player_name_history, player_cosmetic_ownership, player_profiles
+       RESTART IDENTITY CASCADE`,
+    );
+    await pool.query(
+      `INSERT INTO player_profiles (yandex_player_id, persistent_id)
+       VALUES ($1, 'pid-tenure-veteran'), ($2, 'pid-tenure-fresh')`,
+      [VETERAN, FRESH],
+    );
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  test("credits exactly the capped amount (80 days → 50 XP)", async () => {
+    await credit("game-1", VETERAN);
+    const res = await claim(VETERAN).expect(200);
+    expect(res.body).toEqual({ status: "granted", xpAwarded: 50, xp: 51 });
+    expect(await profileXp(VETERAN)).toBe(51);
+
+    const grants = await pool.query(
+      "SELECT kind, xp_awarded, evidence FROM player_xp_grants WHERE yandex_player_id = $1",
+      [VETERAN],
+    );
+    expect(grants.rows).toEqual([
+      { kind: "tenure", xp_awarded: 50, evidence: evidence() },
+    ]);
+  });
+
+  test("a second identical claim credits nothing and returns duplicate", async () => {
+    await credit("game-1", VETERAN);
+    await claim(VETERAN).expect(200);
+    const res = await claim(VETERAN).expect(200);
+    expect(res.body).toEqual({ status: "duplicate", xpAwarded: 50, xp: 51 });
+    expect(await profileXp(VETERAN)).toBe(51);
+
+    // Different evidence from another device changes nothing either.
+    const other = await claim(
+      VETERAN,
+      evidence({ daysPlayed: 7, gameRecordDays: 0 }),
+    ).expect(200);
+    expect(other.body).toEqual({ status: "duplicate", xpAwarded: 50, xp: 51 });
+    const count = await pool.query(
+      "SELECT count(*)::int AS n FROM player_xp_grants WHERE yandex_player_id = $1",
+      [VETERAN],
+    );
+    expect(count.rows[0].n).toBe(1);
+  });
+
+  test("xp = Σ match credits + the one grant", async () => {
+    await credit("game-1", VETERAN);
+    await credit("game-2", VETERAN);
+    await claim(VETERAN, evidence({ daysPlayed: 9, gameRecordDays: 4 })).expect(
+      200,
+    );
+    await credit("game-3", VETERAN);
+
+    const sums = await pool.query(
+      `SELECT
+         (SELECT coalesce(sum(xp_awarded), 0) FROM player_match_xp_credits
+            WHERE yandex_player_id = $1)::int AS credits,
+         (SELECT coalesce(sum(xp_awarded), 0) FROM player_xp_grants
+            WHERE yandex_player_id = $1)::int AS grants`,
+      [VETERAN],
+    );
+    expect(sums.rows[0]).toEqual({ credits: 3, grants: 9 });
+    expect(await profileXp(VETERAN)).toBe(12);
+  });
+
+  test("no_credited_match before any credit — and nothing is written", async () => {
+    await claim(FRESH).expect(422, { error: "no_credited_match" });
+    expect(await profileXp(FRESH)).toBe(0);
+    const grants = await pool.query("SELECT 1 FROM player_xp_grants");
+    expect(grants.rowCount).toBe(0);
+
+    // Once a real match is credited, the same claim succeeds.
+    await credit("game-1", FRESH);
+    await claim(FRESH).expect(200);
+  });
+
+  test("no_profile for an account with no profile row", async () => {
+    await claim("yandex-tenure-ghost").expect(422, { error: "no_profile" });
+  });
+
+  test("two concurrent claims for one account grant once", async () => {
+    await credit("game-1", VETERAN);
+    const [a, b] = await Promise.all([
+      repo.grantTenureXp(VETERAN, 50, evidence()),
+      repo.grantTenureXp(VETERAN, 50, evidence()),
+    ]);
+    expect([a.status, b.status].sort()).toEqual(["duplicate", "granted"]);
+    expect(await profileXp(VETERAN)).toBe(51);
+  });
+
+  test("a grant crossing 100 XP grants earned citizenship", async () => {
+    // 60 real XP, then a 50 XP grant.
+    await pool.query(
+      "UPDATE player_profiles SET xp = 59 WHERE yandex_player_id = $1",
+      [VETERAN],
+    );
+    await credit("game-1", VETERAN);
+    const outcome = await repo.grantTenureXp(VETERAN, 50, evidence());
+    expect(outcome).toMatchObject({
+      status: "granted",
+      xp: 110,
+      citizenshipNewlyGranted: true,
+    });
+    const row = await pool.query(
+      "SELECT is_citizen, citizenship_earned_at FROM player_profiles WHERE yandex_player_id = $1",
+      [VETERAN],
+    );
+    expect(row.rows[0].is_citizen).toBe(true);
+    expect(row.rows[0].citizenship_earned_at).not.toBeNull();
+  });
+
+  test("the schema refuses a non-positive amount and an unknown kind", async () => {
+    await expect(
+      pool.query(
+        `INSERT INTO player_xp_grants (yandex_player_id, kind, xp_awarded, evidence)
+         VALUES ($1, 'tenure', 0, '{}')`,
+        [VETERAN],
+      ),
+    ).rejects.toMatchObject({ code: "23514" });
+    await expect(
+      pool.query(
+        `INSERT INTO player_xp_grants (yandex_player_id, kind, xp_awarded, evidence)
+         VALUES ($1, 'bonus', 5, '{}')`,
+        [VETERAN],
+      ),
+    ).rejects.toMatchObject({ code: "23514" });
+  });
+});
diff --git a/tests/profile-server/TenureGrantRoutes.test.ts b/tests/profile-server/TenureGrantRoutes.test.ts
