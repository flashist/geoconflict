+      res.status(503).json({ error: "tenure_grant_unavailable" });
+      return;
+    }
+    next();
+  };
+  app.use(
+    "/v1/profile/tenure-grant",
+    tenureGrantCors,
+    tenureGrantLimiter,
+    tenureGrantEnabled,
+  );
+
+  if (tenureGrant !== undefined) {
+    // Claim the one-time tenure grant.
+    //
+    // IDENTITY: the CLIENT-asserted yandexPlayerId, the same trust level as
+    // /v1/profile/name-change-request and /v1/payments/yandex/intent (ADR-103).
+    // ⚠️ Known risk: anyone who knows a player's (non-secret) id can claim that
+    // player's grant with made-up evidence — a GIFT of at most TENURE_XP_CAP,
+    // once, to an account that already has a real credited match. The real
+    // player then gets `duplicate`. A signature check on the id belongs here,
+    // before anything else runs, once signed player verification lands (0250).
+    //
+    // AMOUNT: computed here from the evidence by the shared rules. Any amount a
+    // client sends is ignored — the schema does not even read one.
+    //
+    //   Responses: 200 { status: "granted" | "duplicate", xpAwarded, xp } ·
+    //   400 bad_request · 422 { error: below_minimum | implausible |
+    //   window_not_open | window_closed | no_profile | no_credited_match } ·
+    //   429 · 503 tenure_grant_unavailable · 500 internal_error.
+    app.post("/v1/profile/tenure-grant", async (req, res) => {
+      const parsed = TenureGrantRequestSchema.safeParse(req.body);
+      if (!parsed.success) {
+        res.status(400).json({ error: "bad_request" });
+        return;
+      }
+      const evaluation = evaluateTenureClaim(parsed.data.evidence, Date.now());
+      if (!evaluation.ok) {
+        log.info(`tenure grant rejected: ${evaluation.reason}`);
+        res.status(422).json({ error: evaluation.reason });
+        return;
+      }
+      try {
+        const outcome = await tenureGrant.grantTenureXp(
+          parsed.data.yandexPlayerId,
+          evaluation.xpAwarded,
+          parsed.data.evidence,
+        );
+        // Outcome and amount only — never the evidence values.
+        log.info(
+          `tenure grant ${outcome.status}: xpAwarded=${outcome.xpAwarded}`,
+        );
+        if (
+          outcome.status === "no_profile" ||
+          outcome.status === "no_credited_match"
+        ) {
+          res.status(422).json({ error: outcome.status });
+          return;
+        }
+        res.status(200).json({
+          status: outcome.status,
+          xpAwarded: outcome.xpAwarded,
+          xp: outcome.xp,
+        });
+      } catch (error) {
+        log.error(
+          `POST /v1/profile/tenure-grant failed: ${formatError(error)}`,
+        );
+        res.status(500).json({ error: "internal_error" });
+      }
+    });
+  }
+
   return app;
 }
