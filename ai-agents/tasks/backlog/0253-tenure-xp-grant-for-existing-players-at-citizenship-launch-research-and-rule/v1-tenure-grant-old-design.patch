diff --git a/tests/client/TenureEvidence.test.ts b/tests/client/TenureEvidence.test.ts
new file mode 100644
index 0000000..457947e
--- /dev/null
+++ b/tests/client/TenureEvidence.test.ts
@@ -0,0 +1,291 @@
+/**
+ * @jest-environment jsdom
+ */
+// Device-side tenure evidence (task 0253). The snapshot is the definition of
+// "pre-launch", so its write-once rule and its ordering against the day counter
+// are what these tests pin.
+
+jest.mock("../../src/client/flashist/FlashistFacade", () => ({
+  flashistConstants: {
+    analyticEvents: { PLAYER_DAYS_PLAYED: "Player:DaysPlayed" },
+  },
+  flashist_logEventAnalytics: jest.fn(),
+}));
+
+import {
+  localDateString,
+  logDaysPlayedAnalytics,
+  type StorageLike,
+} from "../../src/client/DaysPlayedAnalytics";
+import {
+  TENURE_SNAPSHOT_KEY,
+  readTenureEvidence,
+  snapshotTenureEvidenceOnce,
+} from "../../src/client/TenureEvidence";
+import { TENURE_EVIDENCE_FLOOR_MS } from "../../src/core/profile/TenureGrantContract";
+
+const DAYS_PLAYED_KEY = "geoconflict.player.daysPlayed";
+const LAST_PLAYED_KEY = "geoconflict.player.lastPlayedDate";
+const FIRST_SEEN_KEY = "geoconflict.player.firstSeen";
+const GAME_RECORDS_KEY = "game-records";
+
+function makeStorage(initial: Record<string, string> = {}): StorageLike & {
+  data: Record<string, string>;
+} {
+  const data = { ...initial };
+  return {
+    data,
+    getItem: (key) => data[key] ?? null,
+    setItem: (key, value) => {
+      data[key] = value;
+    },
+  };
+}
+
+function throwingStorage(): StorageLike {
+  return {
+    getItem: () => {
+      throw new Error("SecurityError");
+    },
+    setItem: () => {
+      throw new Error("SecurityError");
+    },
+  };
+}
+
+/** Local-time timestamp, so date-distinct assertions hold in any TZ. */
+function local(y: number, m: number, d: number, h = 12, min = 0): number {
+  return new Date(y, m - 1, d, h, min).getTime();
+}
+
+const TAKEN_AT = local(2026, 9, 19, 10);
+// The claim-time clock, a day after the snapshot.
+const NOW = TAKEN_AT + 86_400_000;
+
+describe("snapshotTenureEvidenceOnce", () => {
+  it("freezes daysPlayed and the time on first run", () => {
+    const storage = makeStorage({ [DAYS_PLAYED_KEY]: "42" });
+    snapshotTenureEvidenceOnce(storage, TAKEN_AT);
+    expect(JSON.parse(storage.data[TENURE_SNAPSHOT_KEY])).toEqual({
+      daysPlayed: 42,
+      takenAt: TAKEN_AT,
+    });
+  });
+
+  it("is written once and never overwritten", () => {
+    const storage = makeStorage({ [DAYS_PLAYED_KEY]: "42" });
+    snapshotTenureEvidenceOnce(storage, TAKEN_AT);
+    storage.data[DAYS_PLAYED_KEY] = "90";
+    snapshotTenureEvidenceOnce(storage, TAKEN_AT + 86_400_000);
+    expect(JSON.parse(storage.data[TENURE_SNAPSHOT_KEY])).toEqual({
+      daysPlayed: 42,
+      takenAt: TAKEN_AT,
+    });
+  });
+
+  it("never overwrites even a corrupt snapshot", () => {
+    const storage = makeStorage({
+      [DAYS_PLAYED_KEY]: "90",
+      [TENURE_SNAPSHOT_KEY]: "{not json",
+    });
+    snapshotTenureEvidenceOnce(storage, TAKEN_AT);
+    expect(storage.data[TENURE_SNAPSHOT_KEY]).toBe("{not json");
+  });
+
+  it("records 0 days for a brand-new or corrupt counter", () => {
+    const fresh = makeStorage();
+    snapshotTenureEvidenceOnce(fresh, TAKEN_AT);
+    expect(JSON.parse(fresh.data[TENURE_SNAPSHOT_KEY]).daysPlayed).toBe(0);
+
+    const corrupt = makeStorage({ [DAYS_PLAYED_KEY]: "abc" });
+    snapshotTenureEvidenceOnce(corrupt, TAKEN_AT);
+    expect(JSON.parse(corrupt.data[TENURE_SNAPSHOT_KEY]).daysPlayed).toBe(0);
+  });
+
+  it("never throws when storage throws", () => {
+    expect(() =>
+      snapshotTenureEvidenceOnce(throwingStorage(), TAKEN_AT),
+    ).not.toThrow();
+  });
+
+  it("taken before the day increment, today is NOT in the snapshot", () => {
+    // The initializeImmediate order: snapshot, then logDaysPlayedAnalytics.
+    const storage = makeStorage({
+      [DAYS_PLAYED_KEY]: "7",
+      [LAST_PLAYED_KEY]: "2000-01-01",
+    });
+    snapshotTenureEvidenceOnce(storage, TAKEN_AT);
+    logDaysPlayedAnalytics(localDateString(), storage);
+    expect(storage.data[DAYS_PLAYED_KEY]).toBe("8");
+    expect(JSON.parse(storage.data[TENURE_SNAPSHOT_KEY]).daysPlayed).toBe(7);
+  });
+});
+
+describe("readTenureEvidence", () => {
+  const snapshot = (daysPlayed = 10, takenAt = TAKEN_AT) =>
+    JSON.stringify({ daysPlayed, takenAt });
+
+  it("returns null without a snapshot", () => {
+    expect(
+      readTenureEvidence(makeStorage({ [DAYS_PLAYED_KEY]: "10" }), NOW),
+    ).toBe(null);
+  });
+
+  it.each([
+    ["corrupt JSON", "{oops"],
+    ["null", "null"],
+    ["missing takenAt", JSON.stringify({ daysPlayed: 3 })],
+    ["string fields", JSON.stringify({ daysPlayed: "3", takenAt: "1" })],
+  ])("returns null for a %s snapshot", (_label, raw) => {
+    expect(
+      readTenureEvidence(makeStorage({ [TENURE_SNAPSHOT_KEY]: raw }), NOW),
+    ).toBeNull();
+  });
+
+  it("returns null when storage throws", () => {
+    expect(readTenureEvidence(throwingStorage(), NOW)).toBeNull();
+  });
+
+  it("counts distinct LOCAL dates, all game types, only before the snapshot", () => {
+    const storage = makeStorage({
+      [TENURE_SNAPSHOT_KEY]: snapshot(),
+      [GAME_RECORDS_KEY]: JSON.stringify({
+        a: {
+          lobby: { gameType: "Singleplayer" },
+          startTime: local(2026, 3, 1, 9),
+        },
+        b: { lobby: { gameType: "Public" }, startTime: local(2026, 3, 1, 23) },
+        c: {
+          lobby: { gameType: "Private" },
+          startTime: local(2026, 3, 2, 0, 5),
+        },
+        d: { lobby: {}, startTime: local(2026, 5, 20) },
+        // After the snapshot — post-launch play, excluded.
+        e: { lobby: {}, startTime: TAKEN_AT + 1 },
+        // No startTime at all.
+        f: { lobby: {} },
+      }),
+    });
+    expect(readTenureEvidence(storage, NOW)).toEqual({
+      daysPlayed: 10,
+      gameRecordDays: 3,
+      firstPlayedAt: local(2026, 3, 1, 9),
+      snapshotTakenAt: TAKEN_AT,
+    });
+  });
+
+  it("firstPlayedAt is the earlier of firstSeen and the earliest game", () => {
+    const firstSeen = local(2026, 1, 15);
+    const storage = makeStorage({
+      [TENURE_SNAPSHOT_KEY]: snapshot(),
+      [FIRST_SEEN_KEY]: String(firstSeen),
+      [GAME_RECORDS_KEY]: JSON.stringify({
+        a: { startTime: local(2026, 3, 1) },
+      }),
+    });
+    expect(readTenureEvidence(storage, NOW)?.firstPlayedAt).toBe(firstSeen);
+  });
+
+  it("ignores a firstSeen after the snapshot", () => {
+    const storage = makeStorage({
+      [TENURE_SNAPSHOT_KEY]: snapshot(),
+      [FIRST_SEEN_KEY]: String(TAKEN_AT + 1),
+    });
+    expect(readTenureEvidence(storage, NOW)).toEqual({
+      daysPlayed: 10,
+      gameRecordDays: 0,
+      firstPlayedAt: null,
+      snapshotTakenAt: TAKEN_AT,
+    });
+  });
+
+  it("survives corrupt game-records", () => {
+    for (const raw of ["{broken", "42", "null", '"text"']) {
+      const storage = makeStorage({
+        [TENURE_SNAPSHOT_KEY]: snapshot(5),
+        [GAME_RECORDS_KEY]: raw,
+      });
+      expect(readTenureEvidence(storage, NOW)?.gameRecordDays).toBe(0);
+    }
+  });
+
+  // Review R2 (round 1): a corrupt/edited snapshot with a negative counter used
+  // to reach the wire and 400 on every page load, forever.
+  it("clamps a negative counter to 0", () => {
+    const storage = makeStorage({ [TENURE_SNAPSHOT_KEY]: snapshot(-5) });
+    expect(readTenureEvidence(storage, NOW)?.daysPlayed).toBe(0);
+  });
+
+  // Review R1 (round 1): an out-of-range timestamp must never reach the
+  // server, which answers a permanent `implausible` and burns the device's claim.
+  describe("out-of-range dates (review R1)", () => {
+    const PRE_FLOOR = TENURE_EVIDENCE_FLOOR_MS - 86_400_000;
+
+    it("drops a game started before the evidence floor", () => {
+      const storage = makeStorage({
+        [TENURE_SNAPSHOT_KEY]: snapshot(),
+        [GAME_RECORDS_KEY]: JSON.stringify({
+          wrongClock: { startTime: PRE_FLOOR },
+          real: { startTime: local(2026, 3, 1) },
+        }),
+      });
+      expect(readTenureEvidence(storage, NOW)).toEqual({
+        daysPlayed: 10,
+        gameRecordDays: 1,
+        firstPlayedAt: local(2026, 3, 1),
+        snapshotTakenAt: TAKEN_AT,
+      });
+    });
+
+    it("drops a firstSeen before the evidence floor", () => {
+      const storage = makeStorage({
+        [TENURE_SNAPSHOT_KEY]: snapshot(),
+        [FIRST_SEEN_KEY]: String(PRE_FLOOR),
+      });
+      expect(readTenureEvidence(storage, NOW)?.firstPlayedAt).toBeNull();
+    });
+
+    it("keeps a timestamp exactly at the floor", () => {
+      const storage = makeStorage({
+        [TENURE_SNAPSHOT_KEY]: snapshot(),
+        [FIRST_SEEN_KEY]: String(TENURE_EVIDENCE_FLOOR_MS),
+      });
+      expect(readTenureEvidence(storage, NOW)?.firstPlayedAt).toBe(
+        TENURE_EVIDENCE_FLOOR_MS,
+      );
+    });
+
+    it("a snapshot taken on a clock set before the floor is unusable (null)", () => {
+      const storage = makeStorage({
+        [TENURE_SNAPSHOT_KEY]: snapshot(10, PRE_FLOOR),
+      });
+      expect(readTenureEvidence(storage, NOW)).toBeNull();
+    });
+
+    it("a snapshot taken on a clock running ahead is clamped to now", () => {
+      const ahead = NOW + 30 * 86_400_000;
+      const storage = makeStorage({
+        [TENURE_SNAPSHOT_KEY]: snapshot(10, ahead),
+        [FIRST_SEEN_KEY]: String(local(2026, 1, 15)),
+        [GAME_RECORDS_KEY]: JSON.stringify({
+          before: { startTime: local(2026, 3, 1) },
+          // Between now and the bad snapshot time — after the clamp, excluded.
+          between: { startTime: NOW + 86_400_000 },
+        }),
+      });
+      expect(readTenureEvidence(storage, NOW)).toEqual({
+        daysPlayed: 10,
+        gameRecordDays: 1,
+        firstPlayedAt: local(2026, 1, 15),
+        snapshotTakenAt: NOW,
+      });
+    });
+  });
+
+  it("clamps an oversized counter to the wire bound", () => {
+    const storage = makeStorage({
+      [TENURE_SNAPSHOT_KEY]: snapshot(5_000_000),
+    });
+    expect(readTenureEvidence(storage, NOW)?.daysPlayed).toBe(100_000);
+  });
+});
diff --git a/tests/client/TenureGrantClaim.test.ts b/tests/client/TenureGrantClaim.test.ts
