@@ -0,0 +1,36 @@
+-- 005_player_xp_grants.sql — free XP grants (task 0253, ADR-112).
+--
+-- Free XP (today: the one-time tenure grant for players who played before
+-- citizenship launched) is recorded HERE, never as a synthetic row in
+-- `player_match_xp_credits`: "match credits" keeps meaning matches. ADR-112
+-- makes this the table every future free grant reuses, each under its own
+-- `kind` and its own owner ruling on the numbers.
+--
+-- Invariant, checkable at any time:
+--   player_profiles.xp = Σ player_match_xp_credits.xp_awarded
+--                      + Σ player_xp_grants.xp_awarded
+--
+-- Column semantics:
+--   kind       — which grant. The CHECK lists every kind that exists; a new
+--                grant adds its kind in its own migration.
+--   xp_awarded — computed and capped by the SERVER from the evidence; a
+--                client-sent amount is never stored.
+--   evidence   — the claim as the server validated it, for audit. No
+--                personal data: day counts and timestamps only.
+--
+-- The primary key is the "one grant of each kind per account, for life" rule.
+-- A second claim hits ON CONFLICT DO NOTHING and credits nothing. Deleting a
+-- profile deletes its grants (same as its match credits).
+--
+-- The migrate.ts runner wraps each file in a single transaction, so there is NO
+-- explicit BEGIN/COMMIT here. Every statement is idempotent (IF NOT EXISTS).
+
+create table if not exists player_xp_grants (
+  yandex_player_id text        not null
+    references player_profiles (yandex_player_id) on delete cascade,
+  kind             text        not null check (kind in ('tenure')),
+  xp_awarded       integer     not null check (xp_awarded > 0),
+  evidence         jsonb       not null,
+  granted_at       timestamptz not null default now(),
+  primary key (yandex_player_id, kind)
+);
diff --git a/src/client/TenureEvidence.ts b/src/client/TenureEvidence.ts
new file mode 100644
index 0000000..0582dba
--- /dev/null
+++ b/src/client/TenureEvidence.ts
@@ -0,0 +1,192 @@
+// Device-side evidence for the one-time tenure XP grant (task 0253, ADR-112).
+// Pure over StorageLike, like DaysPlayedAnalytics.ts: no network, no UI. Every
+// read and write of a PASSED storage is caught. ⚠️ Not "never throws": the
+// `storage = localStorage` default is evaluated BEFORE the try, so a browser
+// that throws on reading `window.localStorage` itself (storage blocked in a
+// cross-site iframe) throws out of the call — the same pre-existing exposure as
+// logDaysPlayedAnalytics() (review R4, round 1; tracked as a follow-up task).
+//
+// "Pre-launch" = before this device first ran the grant build. The server sees
+// no local dates, and `daysPlayed` carries none, so on that first boot the
+// client freezes a snapshot { daysPlayed, takenAt }. It is written BEFORE
+// logDaysPlayedAnalytics() adds today, and it is written whatever the
+// citizenship kill switch says: it is local only, and gating it would let days
+// played while the switch is off leak into the grant.
+
+import {
+  DAYS_PLAYED_KEY,
+  localDateString,
+  type StorageLike,
+} from "./DaysPlayedAnalytics";
+import {
+  TENURE_EVIDENCE_FLOOR_MS,
+  type TenureEvidence,
+} from "../core/profile/TenureGrantContract";
+
+export const TENURE_SNAPSHOT_KEY = "geoconflict.player.tenureSnapshot";
+
+// Written by FlashistFacade.initializeImmediate() (Player:New) and by
+// LocalPersistantStats.startGame() respectively. Must match those writers.
+const FIRST_SEEN_KEY = "geoconflict.player.firstSeen";
+const GAME_RECORDS_KEY = "game-records";
+
+// The request schema's bound; clamping here keeps an oddly large local counter
+// from turning into a 400 that would be retried on every page load.
+const MAX_DAY_COUNT = 100_000;
+
+interface TenureSnapshot {
+  daysPlayed: number;
+  takenAt: number;
+}
+
+function parseNonNegativeInt(raw: string | null): number | null {
+  if (raw === null) {
+    return null;
+  }
+  const value = parseInt(raw, 10);
+  return Number.isFinite(value) && value >= 0 ? value : null;
+}
+
+function readSnapshot(storage: StorageLike): TenureSnapshot | null {
+  try {
+    const raw = storage.getItem(TENURE_SNAPSHOT_KEY);
+    if (raw === null) {
+      return null;
+    }
+    const parsed = JSON.parse(raw) as Partial<TenureSnapshot> | null;
+    if (
+      typeof parsed?.daysPlayed !== "number" ||
+      typeof parsed.takenAt !== "number" ||
+      !Number.isFinite(parsed.daysPlayed) ||
+      !Number.isFinite(parsed.takenAt)
+    ) {
+      return null;
+    }
+    return { daysPlayed: parsed.daysPlayed, takenAt: parsed.takenAt };
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Freeze `{ daysPlayed, takenAt }` the first time this build runs on a device.
+ * An existing snapshot is never overwritten — even a corrupt one, so a damaged
+ * value cannot be "refreshed" into a later, larger count.
+ */
+export function snapshotTenureEvidenceOnce(
+  storage: StorageLike = localStorage,
+  now: number = Date.now(),
+): void {
+  try {
+    if (storage.getItem(TENURE_SNAPSHOT_KEY) !== null) {
+      return;
+    }
+    const snapshot: TenureSnapshot = {
+      daysPlayed: parseNonNegativeInt(storage.getItem(DAYS_PLAYED_KEY)) ?? 0,
+      takenAt: now,
+    };
+    storage.setItem(TENURE_SNAPSHOT_KEY, JSON.stringify(snapshot));
+  } catch {
+    // Storage unavailable (sandboxed iframe, private mode) — no evidence.
+  }
+}
+
+/**
+ * The evidence the claim sends, or null when this device has no usable
+ * snapshot. Parses `game-records` — call it at claim time, never at boot.
+ *
+ * Out-of-range dates never reach the server (review R1, round 1). The server
+ * answers them with a permanent `implausible`, which would burn this device's
+ * claim over a wrong clock rather than over made-up evidence:
+ *   - a game or `firstSeen` before TENURE_EVIDENCE_FLOOR_MS is dropped, the
+ *     mirror of dropping one later than the snapshot;
+ *   - a snapshot taken on a clock running AHEAD is clamped down to `now`, which
+ *     only ever excludes more games, never adds any;
+ *   - a snapshot taken on a clock set before the floor has no recoverable
+ *     pre-launch boundary, so it is treated like a corrupt snapshot: null.
+ */
+export function readTenureEvidence(
+  storage: StorageLike = localStorage,
+  now: number = Date.now(),
+): TenureEvidence | null {
+  const snapshot = readSnapshot(storage);
+  if (snapshot === null || snapshot.takenAt < TENURE_EVIDENCE_FLOOR_MS) {
+    return null;
+  }
+  const takenAt = Math.floor(Math.min(snapshot.takenAt, now));
+
+  let earliest: number | null = null;
+  const consider = (timestamp: number): void => {
+    if (earliest === null || timestamp < earliest) {
+      earliest = timestamp;
+    }
+  };
+
+  const dates = new Set<string>();
+  for (const startTime of readGameStartTimes(storage)) {
+    // Only games started before the snapshot are pre-launch play; one before
+    // the floor is a wrong clock (review R1).
+    if (startTime < takenAt && startTime >= TENURE_EVIDENCE_FLOOR_MS) {
+      dates.add(localDateString(new Date(startTime)));
+      consider(startTime);
+    }
+  }
+
+  try {
+    const firstSeen = parseNonNegativeInt(storage.getItem(FIRST_SEEN_KEY));
+    // A firstSeen after the snapshot is not pre-launch evidence (it can only
+    // happen if storage was partly cleared), and one before the floor is a
+    // wrong clock (review R1) — ignore both rather than send a timestamp the
+    // server rejects as implausible.
+    if (
+      firstSeen !== null &&
+      firstSeen <= takenAt &&
+      firstSeen >= TENURE_EVIDENCE_FLOOR_MS
+    ) {
+      consider(firstSeen);
+    }
+  } catch {
+    // Unreadable — no firstSeen.
+  }
+
+  return {
+    // Clamped at BOTH ends: the writer never stores a negative count, but a
+    // corrupt or edited one would fail the wire schema (400) and be retried on
+    // every page load forever (review R2, round 1).
+    daysPlayed: Math.min(
+      Math.max(0, Math.floor(snapshot.daysPlayed)),
+      MAX_DAY_COUNT,
+    ),
+    gameRecordDays: Math.min(dates.size, MAX_DAY_COUNT),
+    firstPlayedAt: earliest,
+    snapshotTakenAt: takenAt,
+  };
+}
+
+/** Every finite `startTime` in `game-records`, across all game types. */
+function readGameStartTimes(storage: StorageLike): number[] {
+  try {
+    const raw = storage.getItem(GAME_RECORDS_KEY);
+    if (raw === null) {
+      return [];
+    }
+    const records = JSON.parse(raw) as unknown;
+    if (typeof records !== "object" || records === null) {
+      return [];
+    }
+    const times: number[] = [];
+    for (const record of Object.values(records as Record<string, unknown>)) {
+      const startTime = (record as { startTime?: unknown } | null)?.startTime;
+      if (
+        typeof startTime === "number" &&
+        Number.isFinite(startTime) &&
+        startTime >= 0
+      ) {
+        times.push(Math.floor(startTime));
+      }
+    }
+    return times;
+  } catch {
+    return [];
+  }
+}
diff --git a/src/client/TenureGrantClaim.ts b/src/client/TenureGrantClaim.ts
new file mode 100644
index 0000000..84f3fed
--- /dev/null
+++ b/src/client/TenureGrantClaim.ts
@@ -0,0 +1,211 @@
+// Client → profile-server claim of the one-time tenure XP grant (task 0253,
+// ADR-112). Follows NameChangeRequest.ts / CitizenshipPurchase.ts: the
+// orchestration lives outside the card so its outcome mapping and analytics are
+// unit-testable, and every path inside it resolves to a result value. ⚠️ The
+// `storage = localStorage` default is evaluated before the try, so a browser
+// that throws on reading `window.localStorage` rejects the returned promise —
+// the card catches that (review R4, round 1).
+//
+// ACK BEFORE MARKER (ADR-112, findings 1.6): the device marker is written only
+// after a server ANSWER that settles the claim for good. A network error, a
+// timeout, a 5xx, a 429 or an unreadable body leaves no marker, so the next page
+// load retries. A grant the client marked claimed before the server confirmed
+// would be lost for good — there is no re-run.
+
+import { getServerConfigFromClient } from "../core/configuration/ConfigLoader";
+import { TENURE_MIN_DAYS } from "../core/profile/Citizenship";
+import {
+  TenureGrantRejectionSchema,
+  TenureGrantResponseSchema,
+  tenureDaysFromEvidence,
+  type TenureRejectionReason,
+} from "../core/profile/TenureGrantContract";
+import {
+  flashist_logEventAnalytics,
+  flashistConstants,
+} from "./flashist/FlashistFacade";
+import type { StorageLike } from "./DaysPlayedAnalytics";
+import { readTenureEvidence } from "./TenureEvidence";
+import type { TenureGrantModalParams } from "./TenureGrantModal";
+
+export const TENURE_GRANT_MARKER_KEY = "geoconflict.tenureGrant.done";
+
+const TENURE_GRANT_FETCH_TIMEOUT_MS = 10_000;
+
+export type TenureGrantClaimResult =
+  /** Nothing was sent: marker set, guest, no evidence, or no profile API. */
+  | { status: "skipped" }
+  /** The server answered 200 — the modal was opened. */
+  | ({ status: "granted" | "duplicate" } & TenureGrantModalParams)
+  | { status: "rejected"; reason: TenureRejectionReason }
+  /** No usable server answer — retried on the next page load. */
+  | { status: "failed" };
+
+// Settled for good: set the marker. Everything else stays retryable.
+const PERMANENT_REJECTIONS: ReadonlySet<TenureRejectionReason> = new Set([
+  "below_minimum",
+  "implausible",
+  "window_closed",
+]);
+
+const REJECTION_EVENT_SUFFIX: Record<
+  TenureRejectionReason | "duplicate",
+  string
+> = {
+  below_minimum: "BelowMinimum",
+  implausible: "Implausible",
+  window_not_open: "WindowNotOpen",
+  window_closed: "WindowClosed",
+  no_profile: "NoProfile",
+  no_credited_match: "NoCreditedMatch",
+  duplicate: "Duplicate",
+};
+
+function logRejected(reason: TenureRejectionReason | "duplicate"): void {
+  flashist_logEventAnalytics(
+    `${flashistConstants.analyticEvents.CITIZENSHIP_TENURE_GRANT_REJECTED}:${REJECTION_EVENT_SUFFIX[reason]}`,
+  );
+}
+
+function isMarked(storage: StorageLike): boolean {
+  try {
+    return storage.getItem(TENURE_GRANT_MARKER_KEY) !== null;
+  } catch {
+    return false;
+  }
+}
+
+function setMarker(storage: StorageLike, value: string): void {
+  try {
+    storage.setItem(TENURE_GRANT_MARKER_KEY, value);
+  } catch {
+    // Storage unavailable. The snapshot could not have been written either, so
+    // no claim would be attempted on the next load anyway.
+  }
+}
+
+async function resolveApiBase(): Promise<string | null> {
+  try {
+    const base = (await getServerConfigFromClient())
+      .profileApiUrl()
+      .replace(/\/+$/, "");
+    return base.length > 0 ? base : null;
+  } catch {
+    return null;
+  }
+}
+
+/** POST returning {status, json}, or null when no response arrived. */
+async function postClaim(
+  base: string,
+  body: unknown,
+): Promise<{ status: number; json: unknown } | null> {
+  const controller = new AbortController();
+  const timer = setTimeout(
+    () => controller.abort(),
+    TENURE_GRANT_FETCH_TIMEOUT_MS,
+  );
+  try {
+    const response = await fetch(`${base}/v1/profile/tenure-grant`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(body),
+      signal: controller.signal,
+    });
+    const json = await response.json().catch(() => null);
+    return { status: response.status, json };
+  } catch {
+    return null;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+function openModal(params: TenureGrantModalParams): void {
+  try {
+    const modal = document.querySelector("tenure-grant-modal") as
+      | (Element & { show?: (params: TenureGrantModalParams) => void })
+      | null;
+    modal?.show?.(params);
+  } catch {
+    // The grant is committed and marked; a notice that fails to open must not
+    // turn it into a reported failure.
+  }
+}
+
+/**
+ * Claim the tenure grant for `yandexPlayerId` at most once per device. The
+ * caller gates it behind the citizenship kill switch and an authoritative
+ * logged-in profile, and calls it at most once per page load.
+ */
+export async function maybeClaimTenureGrant(
+  yandexPlayerId: string | null,
+  storage: StorageLike = localStorage,
+): Promise<TenureGrantClaimResult> {
+  try {
+    if (isMarked(storage) || yandexPlayerId === null) {
+      return { status: "skipped" };
+    }
+    const evidence = readTenureEvidence(storage);
+    if (evidence === null) {
+      return { status: "skipped" };
+    }
+    const base = await resolveApiBase();
+    if (base === null) {
+      return { status: "skipped" };
+    }
+
+    // The server can only clamp the raw count DOWN, so a raw count below the
+    // minimum is already final — and the snapshot is frozen, so it stays final.
+    if (
+      Math.max(evidence.daysPlayed, evidence.gameRecordDays) < TENURE_MIN_DAYS
+    ) {
+      setMarker(storage, "below_minimum");
+      logRejected("below_minimum");
+      return { status: "rejected", reason: "below_minimum" };
+    }
+
+    const response = await postClaim(base, { yandexPlayerId, evidence });
+    if (response?.status === 200) {
+      const parsed = TenureGrantResponseSchema.safeParse(response.json);
+      if (parsed.success) {
+        // Marker FIRST: if the modal or analytics blew up, the grant must
+        // still never be re-claimed from this device.
+        setMarker(storage, parsed.data.status);
+        const params: TenureGrantModalParams = {
+          days: tenureDaysFromEvidence(evidence),
+          xpAwarded: parsed.data.xpAwarded,
+          xp: parsed.data.xp,
+        };
+        if (parsed.data.status === "granted") {
+          flashist_logEventAnalytics(
+            flashistConstants.analyticEvents.CITIZENSHIP_TENURE_GRANT_CLAIMED,
+            parsed.data.xpAwarded,
+          );
+        } else {
+          // Unmarked device + duplicate = the ack was lost, or another device
+          // claimed first. The XP is real either way, so the player is told.
+          logRejected("duplicate");
+        }
+        openModal(params);
+        return { status: parsed.data.status, ...params };
+      }
+    } else if (response?.status === 422) {
+      const parsed = TenureGrantRejectionSchema.safeParse(response.json);
+      if (parsed.success) {
+        const reason = parsed.data.error;
+        if (PERMANENT_REJECTIONS.has(reason)) {
+          setMarker(storage, reason);
+        }
+        logRejected(reason);
+        return { status: "rejected", reason };
+      }
+    }
+  } catch {
+    // Fall through to failed — never throw to the card.
+  }
+  flashist_logEventAnalytics(
+    flashistConstants.analyticEvents.CITIZENSHIP_TENURE_GRANT_CLAIM_FAILED,
+  );
+  return { status: "failed" };
+}
diff --git a/src/client/TenureGrantModal.ts b/src/client/TenureGrantModal.ts
